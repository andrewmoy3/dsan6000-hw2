   "source": [
    "import boto3, os\n",
    "\n",
    "bucket_name = 'dsan6000-am5030'\n",
    "s3 = boto3.client('s3')\n",
    "s3.create_bucket(Bucket=bucket_name)\n",
    "for file_name in os.listdir('data'):\n",
    "    s3.upload_file(f'data/{file_name}', bucket_name, f'wikipedia-hourly/{file_name}')"
   ]
  }
